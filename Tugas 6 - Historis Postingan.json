    {
      "parameters": {
        "jsCode": "const top5 = $input.all().map(i => i.json);\nconst medali = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣'];\n\nlet pesan = `📊 <b>LAPORAN HARIAN: JAM TERBAIK POSTING</b> 📊\\n`;\npesan += `📅 ${top5[0].tanggalAnalisis}\\n`;\npesan += `📁 Data dianalisis: <b>${top5[0].totalDataDianalisis}</b> postingan\\n`;\npesan += `━━━━━━━━━━━━━━━━━━\\n\\n`;\npesan += `🔥 <b>Top 5 Jam Dengan Engagement Tertinggi:</b>\\n\\n`;\n\ntop5.forEach((d, i) => {\n  pesan += `${medali[i]} <b>${d.jam} WIB</b>\\n`;\n  pesan += `     ⚡ Rata-rata Score: <b>${d.avgEngagement}</b>\\n`;\n  pesan += `     ❤️ ${d.avgLikes}  💬 ${d.avgComments}  🔁 ${d.avgShares}\\n`;\n  pesan += `     📱 ${d.platformTerbanyak} • ${d.jumlahPost} post\\n\\n`;\n});\n\npesan += `━━━━━━━━━━━━━━━━━━\\n`;\npesan += `💡 <b>Rekomendasi:</b> ${top5[0].rekomendasi}\\n`;\npesan += `🧮 <i>Rumus: Likes×1 + Comments×2 + Shares×3</i>`;\n\nreturn [{ json: { pesan } }];"
      },
