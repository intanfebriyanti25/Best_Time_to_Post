    {
      "parameters": {
        "jsCode": "// ===== Fungsi Engagement Score (Tugas 2) =====\nconst BOBOT = { likes: 1, comments: 2, shares: 3 };\n\nfunction hitungEngagementScore(post) {\n  const likes    = Number(post['Likes'])    || 0;\n  const comments = Number(post['Comments']) || 0;\n  const shares   = Number(post['Shares'])   || 0;\n  return (likes * BOBOT.likes) + (comments * BOBOT.comments) + (shares * BOBOT.shares);\n}\n\nconst round2 = n => Math.round(n * 100) / 100;\nconst pad = n => String(n).padStart(2, '0');\n\n// ===== Ambil hanya baris yang valid =====\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r['Jam Posting'] !== undefined && r['Jam Posting'] !== '' && !isNaN(parseInt(r['Jam Posting'], 10)));\n\nconst totalData = rows.length;\n\n// ===== Agregasi per jam (Tugas 3) =====\nconst perJam = {};\nfor (const row of rows) {\n  const jam = parseInt(row['Jam Posting'], 10);\n  if (!perJam[jam]) perJam[jam] = { n: 0, likes: 0, comments: 0, shares: 0, skor: 0, platform: {} };\n  const g = perJam[jam];\n  g.n += 1;\n  g.likes    += Number(row['Likes'])    || 0;\n  g.comments += Number(row['Comments']) || 0;\n  g.shares   += Number(row['Shares'])   || 0;\n  g.skor     += hitungEngagementScore(row);\n  const p = row['Platform'] || '-';\n\n  g.platform[p] = (g.platform[p] || 0) + 1;\n}\n\nconst hasil = Object.entries(perJam).map(([jam, g]) => ({\n  jam: Number(jam),\n  n: g.n,\n  avgLikes: round2(g.likes / g.n),\n  avgComments: round2(g.comments / g.n),\n  avgShares: round2(g.shares / g.n),\n  avgEngagement: round2(g.skor / g.n),\n  totalSkor: g.skor,\n  platformTerbanyak: Object.entries(g.platform).sort((a, b) => b[1] - a[1])[0][0],\n}));\n\n// ===== Urutkan dari tertinggi, ambil 5 teratas =====\nhasil.sort((a, b) => b.avgEngagement - a.avgEngagement);\nconst top5 = hasil.slice(0, 5);\n\nconst REKOMENDASI = [\n  'Waktu terbaik - prioritaskan konten utama',\n  'Sangat baik - cocok untuk konten penting',\n  'Baik - cocok untuk konten pendukung',\n  'Cukup baik - gunakan sebagai alternatif',\n  'Alternatif - gunakan untuk konten ringan',\n];\n\nconst tanggal = new Date().toLocaleDateString('id-ID', {\n  timeZone: 'Asia/Jakarta', day: '2-digit', month: 'long', year: 'numeric',\n});\n\nreturn top5.map((h, i) => {\n  const jamLabel = `${pad(h.jam)}:00-${pad(h.jam)}:59`;\n\n  return {\n    json: {\n      ranking: i + 1,\n      jam: jamLabel,\n      avgEngagement: h.avgEngagement,\n      jumlahPost: h.n,\n      avgLikes: h.avgLikes,\n      avgComments: h.avgComments,\n      avgShares: h.avgShares,\n      platformTerbanyak: h.platformTerbanyak,\n      engagementScore: h.totalSkor,\n      rekomendasi: REKOMENDASI[i],\n      tanggalAnalisis: tanggal,\n      totalDataDianalisis: totalData,\n      pesan: `Peringkat ${i + 1}: ${jamLabel} WIB - rata-rata score ${h.avgEngagement}`,\n    },\n  };\n});"
      },
